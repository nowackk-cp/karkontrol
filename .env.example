# Yalnızca yerel geliştirme. Gerçek anahtarları .env içinde tutun.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
KARKONTROL_ASSISTANT_BACKEND=offline
KARKONTROL_LLM_URL=http://127.0.0.1:8081
KARKONTROL_LLM_MODEL=Qwen3-1.7B-Q8_0
# Optional separate-model judge; only synthetic calibration preparation.
KARKONTROL_JUDGE_URL=http://127.0.0.1:8081
KARKONTROL_JUDGE_MODEL=Qwen3-0.6B-Q8_0
# Production only: use a shared cache with atomic add/incr and its installed driver.
# DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# DJANGO_CACHE_LOCATION=redis://127.0.0.1:6379/1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.invalid
# Enable only when a trusted proxy strips client-supplied forwarded headers.
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
